# Copy to .env (git-ignored) and replace every value.
POSTGRES_PASSWORD=change-me
# At least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
OPSX_JWT_SECRET=
# "development" enables /docs and /openapi.json; anything else (default: production) disables them.
OPSX_ENV=production
# Enables POS webhooks; per-integration signing secrets are derived from it (>= 32 chars).
OPSX_INTEGRATION_KEY=
